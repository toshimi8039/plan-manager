{
  "name": "plan-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "計劃管理 App（Cloudflare Pages + D1）",
  "scripts": {
    "dev": "wrangler pages dev public --d1 DB=plan-manager-db",
    "db:migrate:local": "wrangler d1 migrations apply plan-manager-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply plan-manager-db --remote",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.150.0"
  }
}
